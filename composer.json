{
    "name": "dnadesign/silverstripe-browser-update",
    "description": "Browser update integration for Silverstripe CMS.",
    "license": "MIT",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "browser-update"
    ],
    "require": {
        "php": "^8.4",
        "silverstripe/admin": "^3",
        "silverstripe/framework": "^6",
        "silverstripe/siteconfig": "^6"
    },
    "require-dev": {
        "cambis/silverstripe-rector": "^2.1",
        "ergebnis/composer-normalize": "^2.54",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "2.6.3",
        "silverstripe/standards": "^1.2",
        "slevomat/coding-standard": "^8.31",
        "symplify/easy-coding-standard": "^13.3",
        "wernerkrauss/silverstripe-rector": "^1.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "DNADesign\\BrowserUpdate\\": "src",
            "DNADesign\\BrowserUpdate\\Tests\\": "tests/php"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true,
            "silverstripe/vendor-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "vendor/bin/parallel-lint src tests --colors --blame",
            "vendor/bin/ecs check --ansi",
            "vendor/bin/phpstan analyse --ansi --memory-limit=-1"
        ],
        "lint:fix": [
            "vendor/bin/ecs check --fix --ansi"
        ]
    }
}
